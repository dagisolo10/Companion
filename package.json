{
    "name": "Companion",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "check-types": "turbo run check-types"
    },
    "devDependencies": {
        "prettier": "^3.7.4",
        "turbo": "^2.10.10",
        "typescript": "5.9.2"
    },
    "engines": {
        "node": ">=18"
    },
    "devEngines": {
        "packageManager": {
            "name": "bun",
            "version": "1.3.14"
        }
    },
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "overrides": {
        "react-native-css": "3.0.0",
        "lightningcss": "1.30.1"
    }
}
