{
    "name": "@companion/shared-types",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "dev": "tsc --watch",
