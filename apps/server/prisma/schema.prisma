generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id             String        @id @default(uuid())
    name           String
    username       String        @unique
    experience     Int           @default(0)
    streak         Int           @default(0)
    longestStreak  Int           @default(0)
    public         Boolean       @default(true)
    createdAt      DateTime      @default(now())
    partyMembers   PartyMember[]
    createdQuests  Quest[]         @relation("CreatedQuests")
    createdParties Party[]         @relation("CreatedParties")
    questActivities QuestActivity[]
}

model Party {
    id        String        @id @default(uuid())
    name      String
    code      String        @unique
    public    Boolean       @default(true)
    createdAt DateTime      @default(now())
    creatorId String
    quests    Quest[]
    members   PartyMember[]
    creator   User          @relation("CreatedParties", fields: [creatorId], references: [id])
}

model PartyMember {
    id       String   @id @default(uuid())
    joinedAt DateTime @default(now())
    partyId  String
    userId   String
    user     User     @relation(fields: [userId], references: [id])
    party    Party    @relation(fields: [partyId], references: [id])

    @@unique([userId, partyId])
}

model Quest {
    id          String      @id @default(uuid())
    reward      Int
    title       String
    description String
    mode        Mode
    difficulty  Difficulty
    status      QuestStatus @default(Active)
    completedAt DateTime?
    createdAt   DateTime    @default(now())

    questActivities QuestActivity[]

    partyId   String
    creatorId String
    party     Party  @relation(fields: [partyId], references: [id])
    creator   User   @relation("CreatedQuests", fields: [creatorId], references: [id])
}

model QuestActivity {
    id          String   @id @default(uuid())
    questId     String
    userId      String
    xpAwarded   Int      @default(0)
    completedAt DateTime @default(now())
    quest       Quest    @relation(fields: [questId], references: [id])
    user        User     @relation(fields: [userId], references: [id])

    @@unique([questId, userId])
    @@index([questId])
    @@index([userId])
}

enum QuestStatus {
    Active
    Completed
}

enum Mode {
    Rush
    Normal
}

enum Difficulty {
    Tiny
    Easy
    Normal
    Hard
    Major
}
