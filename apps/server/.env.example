SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY

DATABASE_URL=

# Dev-only auth bypass. Never enable this in production.
# When true, HTTP and socket tokens like "skip-auth" (or "skip-auth:username") are accepted.
DEV_AUTH_ENABLED=false
# Optional identity for the bare "skip-auth" token. A DB-only user is created when needed.
DEV_AUTH_USER_ID=
DEV_AUTH_USER_NAME=Postman Dev
DEV_AUTH_USER_USERNAME=postman_dev
