{
    "expo": {
        "name": "Companion",
        "slug": "Companion",
        "version": "1.0.0",
        "scheme": "companion",
        "orientation": "portrait",
        "icon": "./assets/images/logo.png",
        "userInterfaceStyle": "automatic",
        "ios": {
            "icon": "./assets/expo.icon",
            "bundleIdentifier": "com.dagisolo.Companion"
        },
        "android": {
            "adaptiveIcon": {
                "backgroundColor": "#0A0A0A",
                "foregroundImage": "./assets/images/logo.png"
            },
            "predictiveBackGestureEnabled": false,
            "package": "com.dagisolo.Companion"
        },
        "web": {
            "output": "server",
            "favicon": "./assets/images/favicon.png"
        },
        "plugins": [
            "expo-router",
            [
                "expo-splash-screen",
                {
                    "imageWidth": 160,
                    "backgroundColor": "#208AEF",
                    "image": "./assets/images/logo.png"
                }
            ],
            "expo-sqlite",
            "expo-web-browser",
            "expo-image",
            "expo-status-bar",
            "expo-asset",
            "expo-secure-store"
        ],
        "experiments": {
            "typedRoutes": true,
            "reactCompiler": true
        },
        "extra": {
            "router": {
                "asyncRoutes": {
                    "web": true
                }
            },
            "eas": {
                "projectId": "f158274a-f362-4305-b3f8-fc3035581a3e"
            }
        }
    }
}
